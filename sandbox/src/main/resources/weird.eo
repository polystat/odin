# Method `a.g` is mutually recursive with method `b.i` through the following possible code path:
# a.g -> b.f -> a.h -> b.i -> a.g

[] > a
  [self] > g
    self.f self > @
  [self] > h
    self.i self > @


[] > a
  [self] > f
    self.h self > @
  [self] > i
    self.g self > @
